/var/log/cta/cta-taped*.log {
    # cta-taped refreshes the parent and child log descriptors on SIGUSR1.
    compress
    create 0644 cta tape
    dateext
    dateformat -%Y%m%d-%s
    delaycompress
    hourly
    maxage 2
    minsize 1G
    missingok
    olddir /var/log/cta/old
    rotate 24
    su cta tape
    postrotate
        /usr/bin/systemctl kill --kill-whom=main --signal=USR1 cta-taped.service > /dev/null 2>&1 || true
    endscript
}

# "hourly" controls eligibility; the system-wide logrotate job must also run hourly.
