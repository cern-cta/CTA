.phony: all

all: cta-unit-tests-bare cta-unit-tests-valgrind cta-unit-tests-valgrind-osm-tape cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-base cta-unit-tests-helgrind-scheduler cta-unit-tests-helgrind-object-store-db cta-unit-tests-helgrind-data-transfer cta-unit-tests-helgrind-in-memory-catalogue cta-unit-tests-helgrind-multiprocess

cta-unit-tests-bare:
	MALLOC_CHECK_=3 /usr/bin/cta-unit-tests | ts "bt: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})
	MALLOC_CHECK_=3 /usr/bin/cta-unit-tests-multiprocess | ts "btmp: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-valgrind: cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-multiprocess cta-unit-tests-bare
	valgrind -q @VALGRIND_OPTS_STR@                                               \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/valgrind.suppr           \
	/usr/bin/cta-unit-tests                                                        \
	--gtest_filter="-OSMTapeFileTest.*:EnstoreTapeFileTest.*" 2>&1 | ts "vg: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-valgrind-osm-tape: cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-multiprocess cta-unit-tests-bare
	valgrind -q @VALGRIND_OPTS_STR@                                               \
	--show-mismatched-frees=no                                                    \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/valgrind.suppr           \
  /usr/bin/cta-unit-tests                                                        \
	--gtest_filter="OSMTapeFileTest.*:EnstoreTapeFileTest.*" 2>&1 | ts "vgot: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-valgrind-multiprocess: cta-unit-tests-bare
	valgrind -q @VALGRIND_OPTS_STR@ --child-silent-after-fork=yes                 \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/valgrind.suppr           \
	/usr/bin/cta-unit-tests-multiprocess 2>&1 | ts "vgmp: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-helgrind-base: cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-multiprocess cta-unit-tests-bare
	valgrind -q --tool=helgrind @HELGRIND_OPTS_STR@                               \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/helgrind.suppr           \
	/usr/bin/cta-unit-tests                                                        \
	--gtest_filter=-OStoreDBPlusMockSchedulerTestVFS*:OStoreTestVFS*:OStoreDBPlusMockSchedulerTestVFS*:InMemory* \
	2>&1 | ts "hgb: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-helgrind-scheduler: cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-multiprocess cta-unit-tests-bare
	valgrind -q --tool=helgrind @HELGRIND_OPTS_STR@                               \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/helgrind.suppr           \
	/usr/bin/cta-unit-tests                                                        \
	--gtest_filter=OStoreDBPlusMockSchedulerTestVFS/Scheduler* 2>&1 | ts "hgs: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-helgrind-object-store-db: cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-multiprocess cta-unit-tests-bare
	valgrind -q --tool=helgrind @HELGRIND_OPTS_STR@                               \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/helgrind.suppr           \
	/usr/bin/cta-unit-tests                                                        \
	--gtest_filter=OStoreTestVFS* 2>&1 | ts "hgosdb: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-helgrind-data-transfer: cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-multiprocess cta-unit-tests-bare
	valgrind -q --tool=helgrind @HELGRIND_OPTS_STR@                               \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/helgrind.suppr           \
	/usr/bin/cta-unit-tests                                                        \
	--gtest_filter=OStoreDBPlusMockSchedulerTestVFS/DataTransferSessionTest* 2>&1 | ts "hgdt: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-helgrind-in-memory-catalogue: cta-unit-tests-valgrind-multiprocess cta-unit-tests-helgrind-multiprocess cta-unit-tests-bare
	valgrind -q --tool=helgrind @HELGRIND_OPTS_STR@                               \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/helgrind.suppr           \
	/usr/bin/cta-unit-tests                                                        \
	--gtest_filter=InMemory/* 2>&1 | ts "hgimc: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})

cta-unit-tests-helgrind-multiprocess: cta-unit-tests-valgrind-multiprocess cta-unit-tests-bare
	valgrind -q --tool=helgrind @HELGRIND_OPTS_STR@                               \
	--suppressions=/usr/share/cta-@CTA_VERSION@/unittest/helgrind.suppr           \
	/usr/bin/cta-unit-tests-multiprocess 2>&1 | ts "hgmp: %b %d %H:%M:%S"; (exit $${PIPESTATUS[0]})
