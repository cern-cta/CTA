#!/bin/bash

# SPDX-FileCopyrightText: 2026 CERN
# SPDX-License-Identifier: GPL-3.0-or-later

set -e

# Parameters: %O (merge base) %A (our version and result file) %B (their version)
RESULT_FILE="$2"

echo "[merge-driver] Resolving .secrets.baseline with detect-secrets merge driver..." >&2

# Check if uv is installed
if ! command -v uv &>/dev/null; then
    echo "[merge-driver] Error: uv is required but not installed" >&2
    exit 1
fi

# Create a temporary file for the baseline
TEMP_BASELINE=$(mktemp)
trap "rm -f $TEMP_BASELINE" EXIT

# Verify we have valid input files
if [ ! -f "$RESULT_FILE" ] || [ -z "$RESULT_FILE" ]; then
    echo "[merge-driver] Error: Invalid parameters" >&2
    exit 1
fi

# Start with our version to preserve existing audit decisions.
cp "$RESULT_FILE" "$TEMP_BASELINE"

# Get the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ $? -ne 0 ]; then
    echo "[merge-driver] Error: Could not determine repository root" >&2
    exit 1
fi
echo "[merge-driver] REPO_ROOT=$REPO_ROOT" >&2

# Change to repository root and run detect-secrets scan
echo "[merge-driver] After cd: $(pwd)" >&2
cd "$REPO_ROOT"

# Prepare only the scan tools, preserving other installed development dependencies.
uv sync --locked --only-group source-checks --inexact

# Exclude the tracked baseline explicitly: the scanner only recognizes the temporary file as its baseline.
# Run detect-secrets scan to update the baseline with any new secrets
# First try to use the existing baseline format
if ! uv run --no-sync detect-secrets scan --baseline "$TEMP_BASELINE" --exclude-files '^\.secrets\.baseline$' .; then
    # If updating the existing baseline fails, regenerate from scratch
    echo "[merge-driver] Baseline scan failed, regenerating with current detect-secrets version..." >&2
    if ! uv run --no-sync detect-secrets scan --exclude-files '^\.secrets\.baseline$' . > "$TEMP_BASELINE"; then
        echo "[merge-driver] Error: detect-secrets scan failed" >&2
        exit 1
    fi
fi

# Persist the repository path, not the temporary scan path, in the baseline filter.
uv run --no-sync python - "$TEMP_BASELINE" <<'PYTHON'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
baseline = json.loads(path.read_text())
for filter_config in baseline["filters_used"]:
    if filter_config["path"] == "detect_secrets.filters.common.is_baseline_file":
        filter_config["filename"] = ".secrets.baseline"
path.write_text(json.dumps(baseline, indent=2) + "\n")
PYTHON

echo "[merge-driver] Baseline updated" >&2

echo "[merge-driver] Merge complete" >&2

# Write the resolved baseline directly to the result file
cp "$TEMP_BASELINE" "$RESULT_FILE"
