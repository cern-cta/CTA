#!/bin/bash

# SPDX-FileCopyrightText: 2026 CERN
# SPDX-License-Identifier: GPL-3.0-or-later

set -e

# Parameters: %O (our version) %A (result file) %B (their version)
OURS="$1"
RESULT_FILE="$2"
THEIRS="$3"

echo "[merge-driver] Resolving .secrets.baseline with detect-secrets merge driver..." >&2

# Check if detect-secrets is installed
if ! command -v detect-secrets &>/dev/null; then
    echo "[merge-driver] Error: detect-secrets is required but not installed" >&2
    echo "[merge-driver] Install it with: pip install detect-secrets" >&2
    exit 1
fi

# Create a temporary file for the baseline
TEMP_BASELINE=$(mktemp)
trap "rm -f $TEMP_BASELINE" EXIT

# Start with our version
cp "$OURS" "$TEMP_BASELINE"

# Verify we have valid input files
if [ ! -f "$OURS" ] || [ -z "$RESULT_FILE" ]; then
    echo "[merge-driver] Error: Invalid parameters" >&2
    exit 1
fi

# Get the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ $? -ne 0 ]; then
    echo "[merge-driver] Error: Could not determine repository root" >&2
    exit 1
fi
echo "[merge-driver] REPO_ROOT=$REPO_ROOT" >&2

# Change to repository root and run detect-secrets scan
echo "[merge-driver] After cd: $(pwd)" >&2
cd "$REPO_ROOT"

# Run detect-secrets scan to update the baseline with any new secrets
# First try to use the existing baseline format
if ! detect-secrets scan --baseline "$TEMP_BASELINE" . 2>/dev/null; then
    # If the baseline is incompatible (version mismatch, etc), regenerate from scratch
    echo "[merge-driver] Baseline version mismatch, regenerating with current detect-secrets version..." >&2
    if ! detect-secrets scan . 2>/dev/null > "$TEMP_BASELINE"; then
        echo "[merge-driver] Error: detect-secrets scan failed" >&2
        exit 1
    fi
fi

echo "[merge-driver] Baseline updated" >&2

echo "[merge-driver] Merge complete" >&2

# Write the resolved baseline directly to the result file
cp "$TEMP_BASELINE" "$RESULT_FILE"
