{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cta-container",
      "displayName": "CTA C++ (container)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vscode-el10",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CTA_BUILD_MODE": "compile",
        "CTA_VERSION": "6~dev1-1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cta-container",
      "displayName": "CTA C++ (container)",
      "configurePreset": "cta-container"
    },
    {
      "name": "cta-generated-headers",
      "displayName": "CTA generated headers (protobuf, gRPC, catalogue schema)",
      "configurePreset": "cta-container",
      "targets": [
        "cta-generated-headers"
      ]
    }
  ]
}
