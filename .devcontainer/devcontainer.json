// Development container for CTA on EL10
{
  "name": "CTA (el10)",
  "build": {
    "dockerfile": "../ci/docker/cta/el10/build.Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/shared/CTA,type=bind,z",
  "workspaceFolder": "/shared/CTA",
  // Dependency installation below uses dnf, which needs root.
  "remoteUser": "root",
  // CTA build dependencies are installed from the source package, built in a scratch directory inside the container.
  // Node.js is needed by SonarLint.
  // Generated headers (protobuf, gRPC, catalogue schema) are built up front so that IntelliSense can resolve them.
  "postCreateCommand": "dnf install -y nodejs && ./ci/build/build_packages.sh deps --build-dir /tmp/cta-deps --create-build-dir --build-generator Ninja --scheduler-type objectstore --cta-version 6~dev1-1 --cmake-build-type RelWithDebInfo && cmake --preset cta-container && cmake --build --preset cta-generated-headers",
  // Extensions (CMake Tools, rust-analyzer) need the dependencies above, so do not start them before they are installed.
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        // CMake/C++
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "xaver.clang-format",
        // Python (tests, tooling)
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        // Rust
        "rust-lang.rust-analyzer",
        // Sonar
        "SonarSource.sonarlint-vscode",
        // Protobuf
        "drblury.protobuf-vsc",
        // TOML (config files)
        "tamasfe.even-better-toml",
        // YAML (CI)
        "redhat.vscode-yaml",
        // Dependi (dependency management)
        "fill-labs.dependi"
      ]
    }
  }
}
