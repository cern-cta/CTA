set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --no-project --managed-python --python "$(cat "$script_dir/../../.python-version")" \
  python "$script_dir/src/release_cli.py" "$@"
