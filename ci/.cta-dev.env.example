# Optional per-worktree defaults for cta-dev.sh.
# Copy this file to .cta-dev.env and adjust the values as needed.
# Command-line options override these settings.
# It is recommended to only overwrite the values you want to change, instead of all of the below

CTA_DEV_SCHEDULER_TYPE=objectstore
CTA_DEV_ORACLE_SUPPORT=false
# When true, cta-dev uses CERN internal repos if its reachability probe succeeds.
# Set false to force public repos, equivalent to --use-public-repos.
CTA_DEV_INTERNAL_REPOS=true
CTA_DEV_PLATFORM=el9
CTA_DEV_BUILD_GENERATOR="Ninja"
CTA_DEV_CMAKE_BUILD_TYPE=RelWithDebInfo
CTA_DEV_CTA_VERSION=6-dev
CTA_DEV_NAMESPACE=dev
