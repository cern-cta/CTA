_ctadev() {
    local cta_dev_path project_root
    cta_dev_path=$(type -P cta-dev) || return
    cta_dev_path=$(realpath "$cta_dev_path" 2>/dev/null) || return
    project_root=$(git -C "$(dirname "$cta_dev_path")" rev-parse --show-toplevel 2>/dev/null) || return

    readonly project_root
    local cur prev command
    COMPREPLY=()

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    command="${COMP_WORDS[1]}"

    local global_opts="
        --help
        --platform
        --scheduler-type
        --enable-oracle-support
        --use-public-repos
    "

    local version_opts="
        --cta-version
    "

    local build_opts="
        --reset
        --clean-build-dirs
        --disable-ccache
        --enable-unit-tests
        --force-install
        --enable-address-sanitizer
        --extra-telemetry
        --build-generator
        --cmake-build-type
    "

    local image_opts=""

    # Only valid for deploy: every other command deploys the images it just built locally.
    local deploy_only_opts="
        --cta-image-tag
        --cta-image-registry
    "

    local deploy_opts="
        --with-dcache
        --local-telemetry
        --publish-telemetry
        --eos-image-repository
        --eos-image-tag
        --dcache-image-repository
        --catalogue-config
        --scheduler-config
        --cta-config
        --eos-config
        --spawn-options
        --namespace
    "

    #
    # Complete values for options that expect one.
    #
    case "$prev" in
        --scheduler-type)
            COMPREPLY=( $(compgen -W "objectstore pgsched" -- "$cur") )
            return
            ;;
        --cmake-build-type)
            COMPREPLY=( $(compgen -W \
                "Release Debug RelWithDebInfo MinSizeRel" \
                -- "$cur") )
            return
            ;;
        --build-generator)
            COMPREPLY=( $(compgen -W \
                "Ninja Unix\\ Makefiles" \
                -- "$cur") )
            return
            ;;
        --platform)
            COMPREPLY=( $(compgen -W "el9" -- "$cur") )
            return
            ;;
        --namespace)
            return
            ;;
        --cta-image-registry)
            COMPREPLY=( $(compgen -W \
                "localhost $(jq -r .dev.ctaImageRegistry "${project_root}/project.json")" \
                -- "$cur") )
            return
            ;;
        --cta-version|--cta-image-tag|--eos-image-tag|--eos-image-repository|--dcache-image-repository|--spawn-options)
            return
            ;;
        --catalogue-config|--scheduler-config|--cta-config|--eos-config)
            COMPREPLY=( $(compgen -f -- "$cur") )
            return
            ;;
    esac

    #
    # Complete command.
    #
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( $(compgen -W \
            "build images deploy test up debug all install help" \
            -- "$cur") )
        return
    fi

    #
    # Complete test name.
    #
    if [[ "$command" == "test" || "$command" == "all" ]]; then
        local i
        local seen_test=false

        for ((i=2; i<COMP_CWORD; ++i)); do
            if [[ "${COMP_WORDS[i]}" != -* ]]; then
                seen_test=true
                break
            fi
        done

        if [[ "$seen_test" == false && "$cur" != -* ]]; then
            local tests=""
            if [[ -d "${project_root}/ci/system_tests/tests" ]]; then
                tests=$(for f in "${project_root}"/ci/system_tests/tests/*_test.py; do
                    basename "$f" _test.py
                done)
            fi

            COMPREPLY=( $(compgen -W "$tests" -- "$cur") )
            return
        fi
    fi

    #
    # Complete options.
    #
    case "$command" in
        build)
            COMPREPLY=( $(compgen -W \
                "$global_opts $version_opts $build_opts" \
                -- "$cur") )
            ;;
        images)
            COMPREPLY=( $(compgen -W \
                "$global_opts $version_opts $image_opts" \
                -- "$cur") )
            ;;
        deploy)
            COMPREPLY=( $(compgen -W \
                "$global_opts $version_opts $deploy_opts $deploy_only_opts" \
                -- "$cur") )
            ;;
        test)
            COMPREPLY=( $(compgen -W \
                "$global_opts --namespace" \
                -- "$cur") )
            ;;
        up)
            COMPREPLY=( $(compgen -W \
                "$global_opts $version_opts $build_opts $image_opts $deploy_opts" \
                -- "$cur") )
            ;;
        debug)
            COMPREPLY=( $(compgen -W \
                "$global_opts $version_opts $build_opts $image_opts $deploy_opts" \
                -- "$cur") )
            ;;
        all)
            COMPREPLY=( $(compgen -W \
                "$global_opts $version_opts $build_opts $image_opts $deploy_opts" \
                -- "$cur") )
            ;;
        install|help)
            COMPREPLY=( $(compgen -W \
                "$global_opts" \
                -- "$cur") )
            ;;
    esac
}

complete -F _ctadev cta-dev
