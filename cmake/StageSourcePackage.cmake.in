# CPack normally enumerates the source tree before applying its ignore patterns.
# Large build/cache directories therefore slow packaging even when excluded.
# This source-package staging hook uses file(COPY) to prune excluded subtrees instead.

# A trailing slash matches descendants but not the directory itself.
# Match both so file(COPY) can skip the directory without traversing it.
set(source_exclusions)
foreach(pattern IN LISTS CPACK_SOURCE_IGNORE_FILES)
  string(REGEX REPLACE "/$" "(/|$)" pattern "${pattern}")
  list(APPEND source_exclusions REGEX "${pattern}" EXCLUDE)
endforeach()

# CPack supplies a fresh staging directory; preserve source permissions and timestamps.
file(COPY "@CMAKE_SOURCE_DIR@/"
  DESTINATION "${CMAKE_INSTALL_PREFIX}"
  ${source_exclusions})

# Rust doctests need this header even though the documentation site is excluded.
file(COPY "@CMAKE_SOURCE_DIR@/docs/rust/header.html"
  DESTINATION "${CMAKE_INSTALL_PREFIX}/docs/rust")

# Carry the original revision into RPM and Debian builds, which exclude .git.
file(WRITE "${CMAKE_INSTALL_PREFIX}/cmake/cta-git-commit.txt" "@CTA_GIT_COMMIT@\n")
