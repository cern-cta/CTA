if(CTA_DEB_SOURCE_ONLY)
  execute_process(COMMAND "@CMAKE_CPACK_COMMAND@" -G TGZ --config CPackSourceConfig.cmake
    WORKING_DIRECTORY "@CMAKE_BINARY_DIR@" COMMAND_ERROR_IS_FATAL ANY)
  file(REMOVE_RECURSE "@CTA_DEB_SOURCE@")
  file(ARCHIVE_EXTRACT INPUT "@CMAKE_BINARY_DIR@/@CPACK_SOURCE_PACKAGE_FILE_NAME@.tar.gz"
    DESTINATION "@CTA_DEB_ROOT@")
  file(COPY "@CTA_DEB_ROOT@/debian" DESTINATION "@CTA_DEB_SOURCE@")
  configure_file("@CMAKE_BINARY_DIR@/@CPACK_SOURCE_PACKAGE_FILE_NAME@.tar.gz"
    "@CTA_DEB_ROOT@/cta_@CTA_DEB_UPSTREAM_VERSION@.orig.tar.gz" COPYONLY)
  execute_process(COMMAND "@CTA_DPKG_BUILDPACKAGE@" -S -d -us -uc -j@JOBS_COUNT@
    WORKING_DIRECTORY "@CTA_DEB_SOURCE@" COMMAND_ERROR_IS_FATAL ANY)
else()
  # Reset packaging state, but preserve the compiler's incremental build directory.
  set(packaging_dir "@CMAKE_SOURCE_DIR@/debian")
  if(IS_SYMLINK "${packaging_dir}" OR
      (EXISTS "${packaging_dir}" AND NOT EXISTS "${packaging_dir}/.cta-generated"))
    message(FATAL_ERROR "Refusing to replace non-generated ${packaging_dir}")
  endif()
  file(REMOVE_RECURSE "${packaging_dir}")
  file(COPY "@CTA_DEB_ROOT@/debian" DESTINATION "@CMAKE_SOURCE_DIR@")
  file(WRITE "${packaging_dir}/.cta-generated" "Generated by CTA Debian packaging.\n")
  execute_process(COMMAND "@CMAKE_COMMAND@" -E env
    "CTA_DEB_BUILD_DIR=@CMAKE_BINARY_DIR@/compile"
    "CTA_DEB_OUTPUT_DIR=@CTA_DEB_ROOT@"
    "@CTA_DPKG_BUILDPACKAGE@" -b --no-pre-clean -us -uc -j@JOBS_COUNT@
    "--buildinfo-option=-u@CTA_DEB_ROOT@" "--changes-option=-u@CTA_DEB_ROOT@"
    "--buildinfo-file=@CTA_DEB_ROOT@/cta_@CTA_VERSION@_@CTA_DEB_ARCH@.buildinfo"
    "--changes-file=@CTA_DEB_ROOT@/cta_@CTA_VERSION@_@CTA_DEB_ARCH@.changes"
    WORKING_DIRECTORY "@CMAKE_SOURCE_DIR@" COMMAND_ERROR_IS_FATAL ANY)
endif()
