[Unit]
Description=CERN Tape Archive (CTA) rmcd service
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=cta
Group=tape

RuntimeDirectory=cta/rmcd
RuntimeDirectoryMode=0750
LogsDirectory=cta cta/old
LogsDirectoryMode=0755

EnvironmentFile=-/etc/sysconfig/cta-rmcd
# The device argument is deployment-specific and must be set in the environment file.
ExecStart=/usr/bin/cta-rmcd -f ${CTA_RMCD_OPTIONS}

LimitCORE=infinity
OOMScoreAdjust=-10
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
