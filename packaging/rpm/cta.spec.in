Summary: CERN Tape Archive tape labelling tool
Requires: cta-lib-scheduler = %{version}-%{release}
Requires: xrootd-client-libs %{xrootdVersionConstraint}
Requires(pre): group(tape)
%description -n cta-tape-label
Provides a command-line tool for labelling tapes for use with CTA.
%files -n cta-tape-label
%license COPYING
# CAP_SYS_RAWIO must only be available to trusted tape operators.
%attr(0750,root,tape) %caps(cap_sys_rawio=ep) %{_bindir}/cta-tape-label
%{_mandir}/man1/cta-tape-label.1*

%package -n cta-readtp
Summary: CERN Tape Archive tape reading tool
Requires: cta-lib-scheduler = %{version}-%{release}
Requires: xrootd-client-libs %{xrootdVersionConstraint}
Requires(pre): group(tape)
%description -n cta-readtp
Provides a command-line tool for reading files directly from CTA.
%files -n cta-readtp
%license COPYING
# CAP_SYS_RAWIO must only be available to trusted tape operators.
%attr(0750,root,tape) %caps(cap_sys_rawio=ep) %{_bindir}/cta-readtp
%{_mandir}/man1/cta-readtp.1*

%package -n cta-release
Summary: CERN Tape Archive repository configuration
Requires: python3-dnf-plugin-versionlock
Requires: python3
Requires: epel-release
Requires: jq
%description -n cta-release
Configures package repositories, signing keys and version locks for CTA and its dependencies.
%files -n cta-release
%license COPYING
%config(noreplace) %{_sysconfdir}/yum.repos.d/*
%{_sysconfdir}/pki/rpm-gpg/*
%{_sysconfdir}/yum/pluginconf.d/versionlock.cta
%{_bindir}/cta-versionlock

%package -n cta-eosdf
Summary: CERN Tape Archive EOS disk buffer space reporter
Requires: xrootd-client %{xrootdVersionConstraint}
Requires: sed
%description -n cta-eosdf
Provides a command-line tool that reports free space in the default EOS
namespace used for CTA disk buffers.
%files -n cta-eosdf
%license COPYING
%{_bindir}/cta-eosdf.sh
