# SPDX-FileCopyrightText: 2025 CERN
# SPDX-License-Identifier: GPL-3.0-or-later

# Generic macros
#---------------
%define name cta
%define ctaVersion @CTA_VERSION@
%define ctaRelease @CTA_RELEASE@
%define xrootdSsiVersion @XROOTD_SSI_PROTOBUF_INTERFACE_VERSION@
%define ctaSummary @PROJECT_SUMMARY@
%define ctaLicense @PROJECT_LICENSE@

%define usingObjectstore @RPM_USINGOBJECTSTORE@
%define occiSupport @RPM_USING_ORACLE@
%define schedOpt @RPM_SCHEDOPT@
%define perfTelemetryOpt @RPM_PERF_TELEMETRY_OPT@
%define asanOptions @RPM_ADDRESS_SANITIZER_OPT@
%define oracleOpt @RPM_ORACLE@
%define buildGenerator @CMAKE_GENERATOR@

# Versioning
# Every package defined in project.json BuildRequires has a corresponding variable available containing its version constraint
%define oracleVersionConstraint @ORACLE_INSTANTCLIENT_VERSION_CONSTRAINT@
%define valgrindVersionConstraint @VALGRIND_VERSION_CONSTRAINT@
%define xrootdVersionConstraint @XROOTD_VERSION_CONSTRAINT@
%define radosVersionConstraint @RADOS_VERSION_CONSTRAINT@
%define gtestDevelVersionConstraint @GTEST_VERSION_CONSTRAINT@
%define opentelemetryCppVersionConstraint @OPENTELEMETRY_CPP_VERSION_CONSTRAINT@

# Neutral packaging (for srpm)
#-----------------------------
%if 0%{?neutralpackage:1} > 0
%define mydist %{nil}
%else
%define mydist %{?dist}
%endif

# Skipping unit tests (for developers)
#-------------------------------------
%define skip_unit_tests @PACKAGE_SKIP_UNIT_TESTS@

# Skipping debug packages (for developers)
#-------------------------------------
%define skipDebugPackages @PACKAGE_SKIP_DEBUG_PACKAGES@
%if %{skipDebugPackages}
%define debug_package %{nil}
%endif

# Disable compression of debuginfo, because this takes a huge amount of time
%define _find_debuginfo_dwz_opts %{nil}

# Use zstd for compression instead of gzip (which is incredibly slow)
#--------------------------------------------
%global _binary_payload w3.zstdio
%global _source_payload w3.zstdio

# General settings
#-----------------
Name: %{name}
Summary: %{ctaSummary}
Version: %{ctaVersion}
Release: %{ctaRelease}%{mydist}
Source0: %{name}-%{ctaVersion}-%{ctaRelease}.tar.zst
Source1: cta.conf
URL: https://gitlab.cern.ch/cta/CTA
License: %{ctaLicense}
Vendor: CERN

%define requiredProtobuf protobuf

# This is populated by the project.json from the buildRequires items
@BUILD_REQUIREMENTS@

BuildRequires: systemd-rpm-macros

# PostgreSQL server binaries needed for unit tests when using pgsched
# Note that this should eventually move to project.json once the objectstore is removed
%if "%{schedOpt}" == "-DCTA_USE_PGSCHED:Bool=TRUE"
BuildRequires: postgresql-server
%endif

# only build debug info if you're building the whole code

%description
CERN Tape Archive (CTA) is a scalable tape storage system for archival data.

%prep
%autosetup -D -n %{name}-%{ctaVersion}-%{ctaRelease}

%build

mkdir -p build
cd build
cmake3 -G "%{buildGenerator}" .. -DCMAKE_INSTALL_PREFIX:PATH=/usr -DCTA_SYSTEMD_UNIT_DIR:PATH=lib/systemd/system -DCTA_VERSION:STRING=%{ctaVersion} -DXROOTD_SSI_PROTOBUF_INTERFACE_VERSION:STRING=%{xrootdSsiVersion} -DENABLE_CCACHE:BOOL=@ENABLE_CCACHE@ -DCTA_PACKAGE_MODE:STRING=none -DJOBS_COUNT:STRING=@JOBS_COUNT@ -DVCS_VERSION=%{ctaRelease} %{schedOpt} %{perfTelemetryOpt} %{oracleOpt} %{asanOptions}
cmake --build . --parallel @JOBS_COUNT@

%install
%{__rm} -rf ${RPM_BUILD_ROOT}

cd build
DESTDIR=${RPM_BUILD_ROOT} EXPORTMAN=${RPM_BUILD_ROOT}/usr/share/man cmake --build . --target install --parallel @JOBS_COUNT@

%check
cd build
cmake --build . --target cta-example-config-checks --parallel @JOBS_COUNT@
%if "%{skip_unit_tests}" == "0"
cmake --build . --target cta-unit-tests-short --parallel @JOBS_COUNT@
%endif

# Main packages

%package -n cta-runtime
Summary: CERN Tape Archive system runtime
Requires(pre): group(tape)
%{?sysusers_requires_compat}
%description -n cta-runtime
Provides the system account, configuration directories and shared runtime data
used by CERN Tape Archive services.
%files -n cta-runtime
%license COPYING
%doc CHANGELOG.md
%dir %{_sysconfdir}/cta
%dir %{_datadir}/cta
%{_sysusersdir}/cta.conf
%{_datadir}/cta/cta-logging.schema.json

%pre -n cta-runtime
%sysusers_create_compat %{SOURCE1}

%package -n cta-taped
Summary: CERN Tape Archive tape daemon
Recommends: logrotate
Recommends: systemd
%{?systemd_ordering}
Requires: cta-lib-runtime = %{version}-%{release}
Requires: cta-runtime = %{version}-%{release}
Requires: cta-lib-scheduler = %{version}-%{release}
Requires: cta-lib-catalogue = %{version}-%{release}
Requires: xrootd-client-libs %{xrootdVersionConstraint}
%description -n cta-taped
Provides the daemon that manages tape drives and tape I/O for CTA.
%files -n cta-taped
%license COPYING
%{_libdir}/libctatapedrao.so.*
%config(noreplace) %{_sysconfdir}/logrotate.d/cta-taped
%{_bindir}/cta-taped
%doc %{_docdir}/cta/cta-taped.example.conf
%{_mandir}/man1/cta-taped.1*
%config(noreplace) %{_sysconfdir}/sysconfig/cta-taped
%{_unitdir}/cta-taped.service

%post -n cta-taped
%systemd_post cta-taped.service

%preun -n cta-taped
%systemd_preun cta-taped.service

%postun -n cta-taped
%systemd_postun_with_restart cta-taped.service

%package -n cta-maintd
Summary: CERN Tape Archive maintenance daemon
Recommends: logrotate
Recommends: systemd
%{?systemd_ordering}
Requires: cta-lib-runtime = %{version}-%{release}
Requires: cta-runtime = %{version}-%{release}
Requires: cta-lib-scheduler = %{version}-%{release}
Requires: cta-lib-catalogue = %{version}-%{release}
%description -n cta-maintd
Provides the daemon that performs background maintenance tasks for CTA.
%files -n cta-maintd
%license COPYING
%if "%{usingObjectstore}" != "0"
%{_libdir}/libctaosdbroutines.so*
%else
%{_libdir}/libctardbroutines.so*
%endif
%config(noreplace) %{_sysconfdir}/logrotate.d/cta-maintd
%{_bindir}/cta-maintd
%doc %{_docdir}/cta/cta-maintd.example.toml
%{_mandir}/man1/cta-maintd.1*
%{_unitdir}/cta-maintd.service

%post -n cta-maintd
%systemd_post cta-maintd.service

%preun -n cta-maintd
%systemd_preun cta-maintd.service

%postun -n cta-maintd
%systemd_postun_with_restart cta-maintd.service

%package -n cta-frontend-grpc
Summary: CERN Tape Archive gRPC frontend
Recommends: logrotate
Recommends: systemd
%{?systemd_ordering}
Requires: cta-lib-runtime = %{version}-%{release}
Requires: cta-runtime = %{version}-%{release}
Requires: cta-lib-scheduler = %{version}-%{release}
Requires: cta-lib-catalogue = %{version}-%{release}
%description -n cta-frontend-grpc
Provides the gRPC frontend for admin and workflow commands to CTA.
%files -n cta-frontend-grpc
%license COPYING
%{_bindir}/cta-frontend-grpc
%{_unitdir}/cta-frontend-grpc.service
%config(noreplace) %{_sysconfdir}/sysconfig/cta-frontend-grpc
%doc %{_docdir}/cta/cta-frontend.example.conf
%doc %{_docdir}/cta/cta-frontend-grpc.example.toml
%doc %{_docdir}/cta/jwt-revoke-list.example.toml
%{_mandir}/man1/cta-frontend-grpc.1*

%post -n cta-frontend-grpc
%systemd_post cta-frontend-grpc.service

%preun -n cta-frontend-grpc
%systemd_preun cta-frontend-grpc.service

%postun -n cta-frontend-grpc
%systemd_postun_with_restart cta-frontend-grpc.service

%package -n cta-cli
Summary: CERN Tape Archive command-line interface
Requires: cta-lib-common = %{version}-%{release}
Requires: grpc
%description -n cta-cli
Provides command-line tools for administering CTA.
%files -n cta-cli
%license COPYING
%{_bindir}/cta-admin
%{_mandir}/man1/cta-admin.1*
%doc %{_docdir}/cta/cta-admin.example.conf

%package -n cta-lib-common
Summary: CERN Tape Archive common libraries
# Explicitly require protobuf to avoid a clash with eos-protobuf
Requires: %{requiredProtobuf}
Requires: xrootd-client-libs %{xrootdVersionConstraint}
%description -n cta-lib-common
Provides common shared libraries used by CTA components.
%files -n cta-lib-common
%license COPYING
%{_libdir}/libctacommon.so.*
%{_libdir}/libctatapedaemoncommon.so.*

%package -n cta-lib-telemetry
Summary: CERN Tape Archive telemetry libraries
Requires: cta-lib-common = %{version}-%{release}
Requires: opentelemetry-cpp %{opentelemetryCppVersionConstraint}
%description -n cta-lib-telemetry
Provides shared libraries and instrumentation for CTA telemetry.
%files -n cta-lib-telemetry
%license COPYING
%{_libdir}/libctatelemetry.so.*
# For now cta-lib-telemetry owns all instruments. Arguably not the cleanest, but good enough for now
%{_libdir}/libctatelemetryfrontend.so.*
%{_libdir}/libctatelemetrymaintd.so.*
%{_libdir}/libctatelemetryobjectstore.so.*
%{_libdir}/libctatelemetryrdbms.so.*
%{_libdir}/libctatelemetryscheduler.so.*
%{_libdir}/libctatelemetrytaped.so.*
%doc %{_docdir}/cta/cta-otel.example.yaml

%package -n cta-lib-runtime
Summary: CERN Tape Archive application runtime library
Requires: cta-lib-common = %{version}-%{release}
Requires: cta-lib-telemetry = %{version}-%{release}
%description -n cta-lib-runtime
Provides the shared application runtime library used by CTA services and tools.
%files -n cta-lib-runtime
%license COPYING
%{_libdir}/libctaruntime.so.*

%if "%{occiSupport}" == "1"
%package -n cta-lib-catalogue-occi
Summary: CERN Tape Archive Oracle catalogue plug-in
Provides: cta-lib-catalogue-impl = %{version}-%{release}
Requires: oracle-instantclient-basic %{oracleVersionConstraint}
%description -n cta-lib-catalogue-occi
Provides the shared libraries required to access a CTA catalogue running on Oracle.
%files -n cta-lib-catalogue-occi
%license COPYING
%{_libdir}/libctacatalogueocci.so.*
%{_libdir}/libctardbmsocci.so.*
%endif

%package -n cta-lib-rdbms-postgres
Summary: CERN Tape Archive PostgreSQL RDBMS plug-in
Requires: postgresql-libs
%description -n cta-lib-rdbms-postgres
Provides the PostgreSQL RDBMS plug-in used by CTA.
%files -n cta-lib-rdbms-postgres
%license COPYING
%{_libdir}/libctardbmspostgres.so.*

%package -n cta-lib-catalogue-postgres
Summary: CERN Tape Archive PostgreSQL catalogue plug-in
Requires: cta-lib-rdbms-postgres = %{version}-%{release}
Provides: cta-lib-catalogue-impl = %{version}-%{release}
%description -n cta-lib-catalogue-postgres
Provides the shared libraries required to access a CTA catalogue running on PostgreSQL.
%files -n cta-lib-catalogue-postgres
%license COPYING
%{_libdir}/libctacataloguepostgres.so.*

%package -n cta-lib-catalogue-inmemory
Summary: CERN Tape Archive in-memory catalogue plug-in
Provides: cta-lib-catalogue-impl = %{version}-%{release}
%description -n cta-lib-catalogue-inmemory
Provides the shared libraries required to use the in-memory SQLite catalogue
for CTA.
%files -n cta-lib-catalogue-inmemory
%license COPYING
%{_libdir}/libctacatalogueinmemory.so.*

%package -n cta-lib-catalogue
Summary: CERN Tape Archive catalogue libraries
Requires: cta-lib-common = %{version}-%{release}
Requires: cta-lib-catalogue-impl = %{version}-%{release}
Requires: xrootd-client-libs %{xrootdVersionConstraint}
Recommends: cta-lib-catalogue-postgres = %{version}-%{release}
%description -n cta-lib-catalogue
Provides shared libraries for accessing the CTA catalogue.
%files -n cta-lib-catalogue
%license COPYING
%{_libdir}/libctacatalogue.so.*
%{_libdir}/libctacataloguesqlite.so.*
%{_libdir}/libctadropschemacmd.so.*
%{_libdir}/libctardbms.so.*
%{_libdir}/libctardbmssqlite.so.*
%{_libdir}/libctardbmswrapper.so.*
%{_libdir}/libctaschemachecker.so.*
%{_libdir}/libctastatistics.so.*
%doc %{_docdir}/cta/cta-catalogue.example.conf

%package -n cta-lib-scheduler
Summary: CERN Tape Archive scheduler libraries
Provides: cta-lib = %{version}-%{release}
%if "%{usingObjectstore}" != "0"
Requires: librados2 %{radosVersionConstraint}
%else
Requires: cta-lib-rdbms-postgres = %{version}-%{release}
%endif
# Explicitly require protobuf to avoid a clash with eos-protobuf
Requires: %{requiredProtobuf}
Requires: cta-lib-common = %{version}-%{release}
Requires: xrootd-client-libs %{xrootdVersionConstraint}
%description -n cta-lib-scheduler
Provides shared libraries for CTA scheduling and disk access.
%files -n cta-lib-scheduler
%license COPYING
%{_libdir}/libctascheduler.so.*
%if "%{usingObjectstore}" != "0"
%{_libdir}/libctaobjectstore.so.*
%endif
%{_libdir}/libctadisk.so.*
%doc %{_docdir}/cta/cta-scheduler.example.conf

