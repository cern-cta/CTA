[Unit]
Description=CERN Tape Archive (CTA) tape daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=cta
Group=tape

RuntimeDirectory=cta/taped
RuntimeDirectoryMode=0750
LogsDirectory=cta cta/old
LogsDirectoryMode=0755

# To run multiple instances (one per drive), create a local
# cta-taped@.service template based on this unit and qualify every
# per-process path with %i, for example:
#
#   RuntimeDirectory=cta/taped-%i
#   --runtime-dir=/run/cta/taped-%i
#   --config=/etc/cta/cta-taped-%i.toml
#   --log-file=/var/log/cta/cta-taped-%i.log
#
# Configuration changes require a service restart. SIGUSR1 only refreshes the log file descriptor.
ExecStart=/usr/bin/cta-taped --config=/etc/cta/cta-taped.toml --config-strict --runtime-dir=/run/cta/taped --log-file=/var/log/cta/cta-taped.log

LimitCORE=infinity
OOMScoreAdjust=-10
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
