#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 CERN
# SPDX-License-Identifier: GPL-3.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# PostgreSQL's server tools are outside PATH on Debian.
export PATH := /usr/lib/postgresql/17/bin:$(PATH)

# Source packages retain conventional defaults; local builds override these paths.
CTA_DEB_BUILD_DIR ?= build
CTA_DEB_OUTPUT_DIR ?= ..

# Keep Cargo downloads outside debhelper's disposable HOME; preserve CI overrides.
export CARGO_HOME ?= $(abspath $(CTA_DEB_BUILD_DIR)/.cargo)

%:
	dh $@ --buildsystem=@CTA_DEB_BUILD_SYSTEM@ --builddirectory=$(CTA_DEB_BUILD_DIR)

# An explicit PATH type keeps the relative service directory anchored to the install prefix.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@ -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc -DCTA_SYSTEMD_UNIT_DIR:PATH=lib/systemd/system \
		-DCTA_VERSION=@CTA_VERSION@ -DCTA_BUILD_MODE=compile \
		-DXROOTD_SSI_PROTOBUF_INTERFACE_VERSION=@XROOTD_SSI_PROTOBUF_INTERFACE_VERSION@ \
		-DCTA_USE_PGSCHED=ON -DCTA_WITH_ORACLE=OFF \
		-DCTA_SANITIZERS:STRING=@CTA_SANITIZERS@ \
		-DENABLE_SCCACHE=@ENABLE_SCCACHE@ \
		-DCTA_USE_EXTRA_TELEMETRY=@CTA_USE_EXTRA_TELEMETRY@ \
		-DCTA_BUILD_TEST_PACKAGES=$(if $(filter pkg.cta.notests,$(DEB_BUILD_PROFILES)),OFF,ON)

override_dh_auto_test:
	cmake --build $(CTA_DEB_BUILD_DIR) --target cta-example-config-checks --parallel @JOBS_COUNT@
ifeq (@PACKAGE_RUN_UNIT_TESTS@,1)
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cmake --build $(CTA_DEB_BUILD_DIR) --target cta-unit-tests-short --parallel @JOBS_COUNT@
endif
endif

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install $(CTA_DEB_BUILD_DIR)

# Fail packaging if a newly installed file has no package owner.
override_dh_missing:
	dh_missing --fail-missing

# Keep first installs inactive, but restart already-running services after upgrades.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --restart-after-upgrade

ifeq (@PACKAGE_BUILD_DEBUG_PACKAGES@,0)
# Debug information is stripped below, so optimizing it first is unnecessary.
override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym
endif

# Keep artifacts inside the selected build directory, not beside the checkout.
override_dh_builddeb:
	dh_builddeb --destdir=$(CTA_DEB_OUTPUT_DIR)
