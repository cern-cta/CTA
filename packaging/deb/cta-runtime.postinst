#!/bin/sh
# SPDX-FileCopyrightText: 2026 CERN
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

if [ "$1" = configure ]; then
    if ! getent group cta >/dev/null; then
        addgroup --system cta
    fi
    if ! getent passwd cta >/dev/null; then
        adduser --system --ingroup cta --no-create-home --home /nonexistent \
            --shell /usr/sbin/nologin cta
    fi
fi

#DEBHELPER#
