#!/bin/sh
# SPDX-FileCopyrightText: 2026 CERN
# SPDX-License-Identifier: GPL-3.0-or-later

set -e

# --no-start omits the removal stop; keep other installed CTA services running.
if [ "$1" = remove ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop cta-rmcd.service >/dev/null || true
fi

#DEBHELPER#
